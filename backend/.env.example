# JWT - used in later phases
JWT_SECRET=replace-with-a-long-random-secret

# Email - used in later phases
EMAIL_USER=
EMAIL_PASS=
OWNER_EMAIL=

# WhatsApp - used in later phases
WHATSAPP_NUMBER=
